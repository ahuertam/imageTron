WORLD_LABS_API_KEY=wlt_your_key_here
FAL_KEY=your_fal_key_here
TRIPO_API_KEY=your_tripo_key_here
STABILITY_API_KEY=your_stability_key_here
REPLICATE_API_TOKEN=r8_your_token_here
MESHY_API_KEY=your_meshy_key_here
PORT=3001

# Raíz de la caché en disco (por defecto: backend/outputs). Déjala sin definir
# para usar el valor por defecto — si la dejas vacía, el cache se escribe en el
# directorio de trabajo.
# OUTPUTS_DIR=/ruta/absoluta/a/la/cache

# Límites anti-abuso (cada generación cuesta dinero):
#   RATE_LIMIT_MAX = subidas por IP cada 10 minutos
#   MAX_ACTIVE_JOBS = generaciones simultáneas
# RATE_LIMIT_MAX=10
# MAX_ACTIVE_JOBS=4
